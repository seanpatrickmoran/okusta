body { margin:12px 14px } button { padding:3px 12px; margin:0 4px 7px 0; font:inherit; border:1px solid #778278; background:#faf9f2; color:inherit; cursor:pointer }
button[aria-pressed=true] { background:#344d42; color:white } output { display:block; min-height:1.5em; overflow-wrap:anywhere }
